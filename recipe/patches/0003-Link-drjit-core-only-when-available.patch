From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: conda-forge momentum maintainers <conda-forge@users.noreply.github.com>
Date: Tue, 7 Jul 2026 02:00:00 +0000
Subject: [PATCH] Link drjit-core only when available

The conda-forge drjit-cpp package exports a drjit-core CMake target only for
variants that ship libdrjit-core. linux-aarch64 variants currently provide the
header-only drjit target but no libdrjit-core shared library, so linking the
raw drjit-core name fails with -ldrjit-core not found.
---
 CMakeLists.txt      | 6 +++++-
 axel/CMakeLists.txt | 6 +++++-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0e7ab08..dfd352e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -118,7 +118,12 @@ find_package(Ceres CONFIG REQUIRED)
 find_package(CLI11 CONFIG REQUIRED)
 find_package(Dispenso CONFIG REQUIRED)
 find_package(drjit CONFIG REQUIRED)
+set(MOMENTUM_DRJIT_LIBRARIES drjit)
+if(TARGET drjit-core)
+  list(APPEND MOMENTUM_DRJIT_LIBRARIES drjit-core)
+endif()
+
 find_package(Eigen3 CONFIG REQUIRED)
 if(DEFINED Eigen3_VERSION AND
    (Eigen3_VERSION VERSION_LESS 5.0.0 OR Eigen3_VERSION VERSION_GREATER_EQUAL 5.1.0))
   message(FATAL_ERROR "Momentum requires Eigen 5.0.x; found ${Eigen3_VERSION}")
@@ -271,7 +276,6 @@ mt_library(
   PUBLIC_LINK_LIBRARIES
     Eigen3::Eigen
-    drjit
-    drjit-core
+    ${MOMENTUM_DRJIT_LIBRARIES}
 )
 
 mt_library(
diff --git a/axel/CMakeLists.txt b/axel/CMakeLists.txt
index d11c818..65814f6 100644
--- a/axel/CMakeLists.txt
+++ b/axel/CMakeLists.txt
@@ -16,5 +16,10 @@
 find_package(drjit CONFIG REQUIRED)
+set(AXEL_DRJIT_LIBRARIES drjit)
+if(TARGET drjit-core)
+  list(APPEND AXEL_DRJIT_LIBRARIES drjit-core)
+endif()
+
 find_package(Eigen3 CONFIG REQUIRED)
 if(DEFINED Eigen3_VERSION AND
    (Eigen3_VERSION VERSION_LESS 5.0.0 OR Eigen3_VERSION VERSION_GREATER_EQUAL 5.1.0))
   message(FATAL_ERROR "axel requires Eigen 5.0.x; found ${Eigen3_VERSION}")
@@ -87,8 +92,7 @@ target_link_libraries(${target_name}
     Eigen3::Eigen
     Microsoft.GSL::GSL
     Dispenso::dispenso
-    drjit
-    drjit-core
+    ${AXEL_DRJIT_LIBRARIES}
     nlohmann_json::nlohmann_json
 )
 
